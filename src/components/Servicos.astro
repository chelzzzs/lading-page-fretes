---
import { servicos } from "../data/site";
import Icone from "./Icone.astro";
---

<section id="servicos" class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-32">
  <div data-revelar class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-ambar">Serviços</p>
      <h2 class="mt-3 font-display text-[clamp(2rem,4.5vw,3.25rem)] font-bold leading-tight tracking-tight">O que mais sai por aqui</h2>
    </div>
    <p class="max-w-sm text-tinta/60">Atendimento rápido em toda a região de Curitiba.</p>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 md:mt-12 md:grid-cols-3 md:gap-5">
    {
      servicos.map((servico, i) => (
        <div data-revelar data-atraso={String(0.08 * i)}>
          <article
            class="cartao relative h-full overflow-hidden rounded-3xl bg-white p-6 md:p-7 shadow-[0_1px_0_rgb(0_0_0/0.04),0_20px_50px_-30px_rgb(11_27_59/0.35)] ring-1 ring-tinta/5 hover:shadow-[0_1px_0_rgb(0_0_0/0.04),0_30px_70px_-30px_rgb(11_27_59/0.5)]"
            data-cartao
          >
            <div class="flex items-start justify-between">
              <span class="grid size-12 place-items-center rounded-2xl bg-navy text-ambar">
                <Icone nome={servico.icone} class="size-6" />
              </span>
              <span class="font-display text-sm font-semibold text-tinta/25">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <h3 class="mt-7 font-display md:mt-10 text-2xl font-bold tracking-tight">{servico.titulo}</h3>
            <p class="mt-3 leading-relaxed text-tinta/65">{servico.texto}</p>
          </article>
        </div>
      ))
    }
  </div>
</section>
