---
import { abertura, avaliacao, selos } from "../data/site";
import { linkWhatsApp, mensagemPadrao } from "../lib/whatsapp";
import Caminhao from "./Caminhao.astro";
import Icone from "./Icone.astro";
---

<section class="fundo-abertura relative isolate flex min-h-[100svh] items-center overflow-hidden text-white">
  <canvas class="absolute inset-0 -z-10 size-full" data-shader aria-hidden="true"></canvas>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-noite to-transparent" aria-hidden="true"></div>

  <div class="mx-auto w-full max-w-6xl px-5 pb-44 pt-24 md:px-8 md:pb-28 md:pt-28">
    <p data-revelar class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm text-white/80">
      <span class="pulso size-2 rounded-full bg-ambar"></span>
      {abertura.selo}
    </p>

    <h1 class="mt-6 max-w-2xl font-display text-[clamp(2.15rem,5.4vw,4.4rem)] font-bold leading-[0.98] tracking-tight">
      <span data-revelar data-atraso="0.08" class="block">{abertura.titulo}</span>
      <span data-revelar data-atraso="0.18" class="block text-ambar">{abertura.destaque}</span>
    </h1>

    <p data-revelar data-atraso="0.28" class="mt-5 max-w-xl text-base leading-relaxed sm:mt-6 sm:text-lg text-white/75">{abertura.texto}</p>

    <div data-revelar data-atraso="0.38" class="mt-8 flex flex-col gap-3 sm:mt-9 sm:flex-row">
      <a
        href={linkWhatsApp(mensagemPadrao())}
        class="inline-flex items-center justify-center gap-2.5 whitespace-nowrap rounded-full bg-wpp px-5 py-4 font-semibold sm:px-7 text-noite shadow-[0_12px_40px_-12px_rgb(37_211_102/0.7)] transition-transform hover:-translate-y-0.5"
      >
        <Icone nome="whatsapp" />
        Orçamento no WhatsApp
      </a>
      <a href="#servicos" class="hidden items-center justify-center rounded-full sm:inline-flex border border-white/20 px-7 py-4 font-semibold text-white transition-colors hover:bg-white/10">
        Ver serviços
      </a>
    </div>

    <ul data-revelar data-atraso="0.48" class="mt-7 flex flex-wrap sm:mt-10 gap-x-6 gap-y-3 text-sm text-white/80">
      <li>
        <a href={avaliacao.link} target="_blank" rel="noopener" class="flex items-center gap-2 text-white transition-opacity hover:opacity-80">
          <span class="flex text-ambar">
            {Array.from({ length: 5 }, () => <Icone nome="estrela" class="size-3.5" />)}
          </span>
          <span><strong class="font-semibold">{avaliacao.nota}</strong> · {avaliacao.total} avaliações no Google</span>
        </a>
      </li>
      {
        selos.map((selo) => (
          <li class="flex items-center gap-2">
            <span class="grid size-5 place-items-center rounded-full bg-ambar/15 text-ambar">
              <Icone nome="check" class="size-3" />
            </span>
            {selo}
          </li>
        ))
      }
    </ul>
  </div>

  <Caminhao />
</section>
