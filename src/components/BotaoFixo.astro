---
import { linkWhatsApp, mensagemPadrao } from "../lib/whatsapp";
import Icone from "./Icone.astro";
---

<div
  class="pointer-events-none fixed inset-x-0 bottom-0 z-50 px-4 pb-[max(1rem,env(safe-area-inset-bottom))] opacity-0 transition-[opacity,translate] duration-300 translate-y-4 data-[visivel]:pointer-events-auto data-[visivel]:translate-y-0 data-[visivel]:opacity-100 md:hidden"
  data-botao-fixo
>
  <a
    href={linkWhatsApp(mensagemPadrao())}
    class="flex items-center justify-center gap-2.5 rounded-full bg-wpp px-6 py-4 font-semibold text-noite shadow-[0_16px_40px_-12px_rgb(0_0_0/0.45)]"
  >
    <Icone nome="whatsapp" />
    Orçamento no WhatsApp
  </a>
</div>
